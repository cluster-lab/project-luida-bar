        \"exp_participantMoveSpeed\", 1);\n  }\n}\n\n\nfunction DuringState(deltaTime)
        {\n  const STATE_ID = $.state.state_id;\n  const CONDITION = $.groupState.currentCondition;\n\n}\n\n\nfunction
        OnStateExit() {\n  const STATE_ID = $.state.state_id;\n  const CONDITION
        = $.groupState.currentCondition;\n\n  if (STATE_ID === 0) {\n    \n$.setStateCompat(\"owner\",
        \"exp_participantMoveSpeed\", 1);\n  }\n  if (STATE_ID === 10) {\n    $.setStateCompat('this',
        'exp_showItem', false);\n  }\n}\n\n\n\n"
