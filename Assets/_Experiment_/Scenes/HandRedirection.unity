--- !u!1001 &7533049804749356258
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 97919917519858158, guid: c429a845517c96a419988cd638c846f1,
