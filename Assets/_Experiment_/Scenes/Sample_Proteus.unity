    - target: {fileID: 908684358854966727, guid: c429a845517c96a419988cd638c846f1,
        type: 3}
      propertyPath: m_Name
      value: ExpTemplateRequiredObjects
      objectReference: {fileID: 0}
    - target: {fileID: 2948447358681182120, guid: c429a845517c96a419988cd638c846f1,
        type: 3}
      propertyPath: clusterScripts.Array.size
      value: 2
