PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    m_TransformParent: {fileID: 814595608}
    m_Modifications:
    - target: {fileID: 600138418, guid: bebbd8fabd7b322468f1d18e8b32081c, type: 3}
