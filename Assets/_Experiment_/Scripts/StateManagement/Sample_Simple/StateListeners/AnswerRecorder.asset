  stateListeners:
  - stateID: 2
    onStateStartedActions:
    - predefinedActionTemplate:
        actionType: Customized Action
        codeSnippet: 
        variables: []
      customAction: '$.state.isAnswering = true;

        $.state.answerTime = 0;'
      isConditional: 0
      conditionVariable: 
      conditionValue: 
      _variableKeys: []
      _variableValuesList: []
    duringStateActions: []
    onStateExitedActions:
    - predefinedActionTemplate:
        actionType: Customized Action
        codeSnippet: 
        variables: []
      customAction: '$.state.isAnswering = false;

        $.setStateCompat("owner",
        "answerTime", $.state.answerTime);'
      isConditional: 0
      conditionVariable: 
      conditionValue: 
      _variableKeys: []
      _variableValuesList: []
    - predefinedActionTemplate:
        actionType: Record custom data
        codeSnippet: $.sendSignalCompat('this', 'exp_recordCustomData');
        variables: []
      customAction: 
      isConditional: 0
      conditionVariable: 
      conditionValue: 
      _variableKeys: []
      _variableValuesList: []
  - stateID: 4
    onStateStartedActions:
    - predefinedActionTemplate:
        actionType: Upload recorded data
        codeSnippet: $.sendSignalCompat('this', 'exp_uploadCustomData');
        variables: []
      customAction: 
      isConditional: 0
      conditionVariable: 
      conditionValue: 
      _variableKeys: []
      _variableValuesList: []
    duringStateActions: []
    onStateExitedActions: []
  otherImplementation: "function Update(deltaTime) {\n  if ($.state.isAnswering)
    $.state.answerTime += deltaTime;\n}"
