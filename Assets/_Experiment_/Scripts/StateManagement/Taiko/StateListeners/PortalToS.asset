        PARTICIPANTS[0].setPosition(new
        Vector3(0, 0, -2));'
      isConditional: 1
      conditionVariable: selfAvatar
      conditionValue: suit
      _variableKeys: []
      _variableValuesList: []
    - predefinedActionTemplate:
        actionType: Sleep
