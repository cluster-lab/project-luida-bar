%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: acb8c4c8a0a4dc6418e2f4d59454f5e3, type: 3}
  m_Name: TargetPoint
  m_EditorClassIdentifier: 
  stateListeners:
  - stateID: 0
    onStateStartedActions:
    - predefinedAction:
        actionType: Hide item
        codeSnippet: $.setStateCompat('this', 'exp_showItem', false);
      customAction: 
      showCustomActionFoldout: 0
    onStateStartedFoldout: 1
    duringStateActions: []
    duringStateFoldout: 0
    onStateExitedActions: []
    onStateExitedFoldout: 0
  - stateID: 2
    onStateStartedActions:
    - predefinedAction:
        actionType: 
        codeSnippet: 
      customAction: "if (!$.state.player) $.state.player = $.getPlayersNear($.getPosition(),
        Infinity)[0];\nif (!$.state.practiceID) $.state.practiceID = 0;\n\n// \u30BF\u30FC\u30B2\u30C3\u30C8\u306E\u5EA7\u6A19\nlet
        param = practiceParams[$.state.practiceID];\nlet originPos = $.state.player.getHumanoidBonePosition(HumanoidBone.Head)\n 
        .clone().add(new Vector3(0, 0, 0.5));\n$.setPosition(originPos.add(new Vector3(param.x
        / 300, param.y / 300, param.z / 300)));\n\n// \u30BF\u30FC\u30B2\u30C3\u30C8\u306E\u30B5\u30A4\u30BA\nlet
        s = param.s / 300;\n$.getUnityComponent(\"Transform\").unityProp.localScale
        = new Vector3(s, s, s);"
      showCustomActionFoldout: 1
    - predefinedAction:
        actionType: Show item
        codeSnippet: $.setStateCompat('this', 'exp_showItem', true);
      customAction: 
      showCustomActionFoldout: 0
    onStateStartedFoldout: 1
    duringStateActions: []
    duringStateFoldout: 0
    onStateExitedActions:
    - predefinedAction:
        actionType: Hide item
        codeSnippet: $.setStateCompat('this', 'exp_showItem', false);
      customAction: 
      showCustomActionFoldout: 0
    - predefinedAction:
        actionType: 
        codeSnippet: 
      customAction: $.state.practiceID = $.state.practiceID + 1;
      showCustomActionFoldout: 1
    onStateExitedFoldout: 1
  - stateID: 5
    onStateStartedActions:
    - predefinedAction:
        actionType: 
        codeSnippet: 
      customAction: "if (!$.state.player) $.state.player = $.getPlayersNear($.getPosition(),
        Infinity)[0];\n\n// xy\u8DDD\u96E2\u306E\u5B9F\u9A13\u6761\u4EF6\u304B\u3089xy\u5EA7\u6A19\u3092\u30E9\u30F3\u30C0\u30E0\u306B\u6C7A\u3081\u308B\nlet
        xyCoord = xyCoordCandidates[parseInt(CONDITION[\"xy\"])][Math.floor(Math.random()
        * 4)];\n\n// \u30BF\u30FC\u30B2\u30C3\u30C8\u3092\u6307\u5B9A\u3055\u308C\u305F\u4F4D\u7F6E\u307E\u3067\u52D5\u304B\u3059\nlet
        x = xyCoord.x / 300;\nlet y = xyCoord.y / 300;\nlet z = parseInt(CONDITION[\"d\"])
        / 300;\nlet originPos = $.state.player.getHumanoidBonePosition(HumanoidBone.Head)\n 
        .clone().add(new Vector3(0, 0, 0.5));\n$.setPosition(originPos.add(new Vector3(x,
        y, z)));\n\n// \u30BF\u30FC\u30B2\u30C3\u30C8\u306E\u30B5\u30A4\u30BA\u3092\u5B9F\u9A13\u6761\u4EF6\u306B\u5408\u308F\u305B\u308B\nlet
        s = parseInt(CONDITION[\"s\"]) / 300;\n$.getUnityComponent(\"Transform\").unityProp.localScale
        = new Vector3(s, s, s);\n\n// x\u3068y\u306E\u5024\u3092\u4FDD\u5B58\u3059\u308B\n$.setStateCompat(\"owner\",
        \"x\", xyCoord.x);\n$.setStateCompat(\"owner\", \"y\", xyCoord.y);"
      showCustomActionFoldout: 1
    - predefinedAction:
        actionType: Show item
        codeSnippet: $.setStateCompat('this', 'exp_showItem', true);
      customAction: 
      showCustomActionFoldout: 0
    onStateStartedFoldout: 1
    duringStateActions: []
    duringStateFoldout: 0
    onStateExitedActions:
    - predefinedAction:
        actionType: Hide item
        codeSnippet: $.setStateCompat('this', 'exp_showItem', false);
      customAction: 
      showCustomActionFoldout: 0
    onStateExitedFoldout: 1
  otherImplementation: "const practiceParams = [\n  { x: -50, y: 50, z: 0, s: 16
    },\n  { x: 10, y: 10, z: -25, s: 2 },\n  { x: 30, y: -30, z: 50, s: 48 }\n];\n\nconst
    xyCoordCandidates = [\n   [{ x: 10, y: 10 }, { x: -10, y: 10 }, { x: 10 , y:
    -10 }, { x: -10, y: -10 }],\n   [{ x: 30, y: 0  }, { x: 0  , y: 30 }, { x: -30,
    y: 0   }, { x: 0  , y: -30 }],\n   [{ x: 30, y: 30 }, { x: -30, y: 30 }, { x:
    30 , y: -30 }, { x: -30, y: -30 }],\n   [{ x: 50, y: 0  }, { x: 0  , y: 50 },
    { x: -50, y: 0   }, { x: 0  , y: -50 }],\n   [{ x: 50, y: 50 }, { x: -50, y:
    50 }, { x: 50 , y: -50 }, { x: -50, y: -50 }]\n];"
