  stateListeners:
  - stateID: 2
    onStateStartedActions:
    - predefinedActionTemplate:
        actionType: Customized Action
        codeSnippet: 
        variables: []
      customAction: "let player = $.getPlayersNear(\n  new Vector3(0,0,0), Infinity)[0];\nplayer.requestTextInput(\n 
        \"ask_to_calculate\",\n  getRandomInt(100) + \"+\" + getRandomInt(100) +
        \"=?\"\n);"
      isConditional: 0
      conditionVariable: 
      conditionValue: 
      _variableKeys: []
      _variableValuesList: []
    duringStateActions: []
    onStateExitedActions: []
  otherImplementation: "function getRandomInt(max) {\n  return Math.floor(Math.random()
    * max);\n}\n$.onTextInput((text, meta, status) => {\n  if (status === TextInputStatus.Success)
    {\n    ToNextState();\n  }\n});"
