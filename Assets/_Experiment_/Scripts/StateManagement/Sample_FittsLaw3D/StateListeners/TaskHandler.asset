  stateListeners:
  - stateID: 9
    onStateStartedActions:
    - predefinedAction:
        actionType: 
        codeSnippet: 
      customAction: $.state.taskTime = 0;
      showCustomActionFoldout: 1
    onStateStartedFoldout: 1
    duringStateActions:
    - predefinedAction:
        actionType: 
        codeSnippet: 
      customAction: "if ($.getStateCompat(\"global\", \"isInTask\", \"boolean\"))
        {\n  $.state.taskTime = $.state.taskTime + deltaTime;\n}"
      showCustomActionFoldout: 1
    duringStateFoldout: 1
    onStateExitedActions:
    - predefinedAction:
        actionType: 
        codeSnippet: 
      customAction: $.setStateCompat("owner", "taskTime", $.state.taskTime);
      showCustomActionFoldout: 1
    - predefinedAction:
        actionType: Record custom data
        codeSnippet: $.sendSignalCompat('this', 'exp_recordCustomData');
      customAction: 
      showCustomActionFoldout: 0
    onStateExitedFoldout: 1
  - stateID: 11
    onStateStartedActions:
    - predefinedAction:
        actionType: Upload recorded data
        codeSnippet: $.sendSignalCompat('this', 'exp_uploadCustomData');
