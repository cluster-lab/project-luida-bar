      value: 0.7
      objectReference: {fileID: 0}
    - target: {fileID: 1100467477985630895, guid: d54fd1885b76d47d9bd9a3a2f0675afb,
        type: 3}
      propertyPath: m_LocalScale.y
      value: 0.4
      objectReference: {fileID: 0}
    - target: {fileID: 1100467477985630895, guid: d54fd1885b76d47d9bd9a3a2f0675afb,
        type: 3}
      propertyPath: m_LocalPosition.y
      value: 0.03
      objectReference: {fileID: 0}
    - target: {fileID: 1991786752229540810, guid: d54fd1885b76d47d9bd9a3a2f0675afb,
        type: 3}
      propertyPath: text
      value: "\u4E2D\u65AD\u307E\u305F\u306F\u7D42\u4E86\u3057\u305F\u30BB\u30C3\u30B7\u30E7\u30F3\u306B\u5165\u3063\u305F\u3088\u3046\u3067\u3059\u3002\n\u300COK\u300D\u3092\u62BC\u3057\u3066\u5B9F\u9A13\u3092\u6700\u521D\u304B\u3089\u59CB\u3081\u3066\u304F\u3060\u3055\u3044\u3002\nIt
        seems you have entered a session that\nwas interrupted or has ended.\nPlease
        press OK to start the experiment\nfrom the beginning."
      objectReference: {fileID: 0}
    - target: {fileID: 2089283526597471262, guid: d54fd1885b76d47d9bd9a3a2f0675afb,
        type: 3}
      propertyPath: sourceCode
      value: "const haptics = _.hapticsHandle;\r\n\r\n_.onReceive((id, body, sender)
        => {\r\n    switch (id) {\r\n        case \"haptics\":\r\n            if
        (haptics.isAvailable()) {\r\n                const effect = new HapticsEffect();\r\n               
        effect.frequency = body.frequency;\r\n                effect.amplitude =
        body.amplitude;\r\n                effect.duration = body.duration;\r\n               
        haptics.playEffect(effect, body.target);\r\n            }\r\n           
        break;\r\n        case \"sendOsc\":\r\n            sendOsc(body.address,
        body.values);\r\n            break;\r\n        case \"initializeParticipant\":\r\n           
        _.setMoveSpeedRate(1);\r\n            _.sendTo(sender, \"envInfoResponse\",
        {\r\n                isAndroid: _.isAndroid,\r\n                isDesktop:
        _.isDesktop,\r\n                isIos: _.isIos,\r\n                isMacOs:
        _.isMacOs,\r\n                isMobile: _.isMobile,\r\n                isVr:
        _.isVr,\r\n                isWindows: _.isWindows\r\n            });\r\n           
        break;\r\n        case \"setQuestionnaireUI\":\r\n            setQuestionnaireUI(body.n,\r\n               
        (body.hasOwnProperty(\"e\") ? body.e : null),\r\n                body.p,
        body.r,\r\n                (body.hasOwnProperty(\"t\") ? body.t.toString()
        : null));\r\n            break;\r\n        case \"setQuestionnaireUIs\":\r\n           
        for (const ui of body) {\r\n                setQuestionnaireUI(ui.n,\r\n                   
        (ui.hasOwnProperty(\"e\") ? ui.e : null),\r\n                    ui.p, ui.r,\r\n                   
        (ui.hasOwnProperty(\"t\") ? ui.t.toString() : null));\r\n            }\r\n           
        break;\r\n        case \"clearQuestionnaireAnswerUIs\":\r\n            let
        targetUI = _.playerLocalObject(\"luida_questionnaire_ui\").findObject(\"AnsText\");\r\n           
        targetUI.setEnabled(false);\r\n            for (let i = 0; i < 20; i++) {\r\n               
        targetUI = _.playerLocalObject(\"luida_questionnaire_ui\").findObject(\"AnsOptLabel_\"
        + i);\r\n                if (targetUI) {\r\n                    targetUI.setEnabled(false);\r\n               
        } else {\r\n                    break;\r\n                }\r\n           
        }\r\n            break;\r\n        default:\r\n            break;\r\n   
        }\r\n});\r\n\r\nfunction setQuestionnaireUI(targetName, isEnabled, position,
        rotation, text) {\r\n    let targetUI = _.playerLocalObject(\"luida_questionnaire_ui\").findObject(targetName);\r\n   
        if (!targetUI) return;\r\n    if (isEnabled !== null) targetUI.setEnabled(isEnabled);\r\n   
        if (position) targetUI.getUnityComponent(\"Transform\").unityProp.localPosition
        = position;\r\n    if (rotation) targetUI.getUnityComponent(\"Transform\").unityProp.localRotation
        = rotation;\r\n    if (text !== null) targetUI.findObject(\"Text\").getUnityComponent(\"Text\").unityProp.text
        = text;\r\n}\r\n\r\nfunction sendOsc(address, values) {\r\n    if (typeof
        _ === 'undefined' || typeof _.oscHandle === 'undefined') {\r\n        _.log(\"Error:
        PlayerScript environment or oscHandle not found.\");\r\n        return;\r\n   
        }\r\n\r\n    try {\r\n        const oscValues = values.map(val => {\r\n           
        const type = typeof val;\r\n            if (type === 'boolean') {\r\n               
        return OscValue.bool(val);\r\n            } else if (type === 'number') {\r\n               
        if (Number.isInteger(val)) {\r\n                    return OscValue.int(val);\r\n               
        } else {\r\n                    return OscValue.float(val);\r\n               
        }\r\n            } else if (type === 'string') {\r\n                return
        OscValue.asciiString(val);\r\n            } else {\r\n                _.log(`Warning:
        Unsupported data type '${type}' for value '${val}'. Skipping.`);\r\n               
        return null;\r\n            }\r\n        }).filter(v => v !== null);\r\n       
        const message = new OscMessage(address, oscValues);\r\n        _.oscHandle.send(message);\r\n       
        // _.log(`OSC message sent to ${address} with ${oscValues.length} value(s).`);\r\n\r\n   
        } catch (e) {\r\n        _.log(`Error sending OSC message: ${e.message}`);\r\n   
        }\r\n}\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 2156336702275513962, guid: d54fd1885b76d47d9bd9a3a2f0675afb,
        type: 3}
      propertyPath: m_LocalPosition.y
      value: -0.1
      objectReference: {fileID: 0}
    - target: {fileID: 3933797981565559285, guid: d54fd1885b76d47d9bd9a3a2f0675afb,
        type: 3}
      propertyPath: sourceCode
      value: "expID = \"expID_example\";\ntoken = \"token_example\";\ncallExternalEndpointID
        = \"callExternalEndpointID_example\";\npNum = 1;\nisTestMode = true;\n\r\nconst
        REJECTION_GATE_POS = new Vector3(-100, 100, -100);\n\nfunction enqueueRejection(idfc,
        reason) {\n    $.log(\"Rejected \" + idfc + \": \" + (reason || \"unknown\"));\n   
        $.groupState.participants = $.groupState.participants.filter(\n        p
        => p.idfc !== idfc\n    );\n    $.state.participantIdfcs = ($.state.participantIdfcs
        || []).filter(k => k !== idfc);\n    $.state.participantsEnvInfo = $.state.participantsEnvInfo.filter(\n       
        info => info.idfc !== idfc\n    );\n    let cleanedIdfc2userId = { ...$.state.idfc2userId
        };\n    delete cleanedIdfc2userId[idfc];\n    $.state.idfc2userId = cleanedIdfc2userId;\n   
        $.state.rejectionQueue = [...$.state.rejectionQueue, { idfc: idfc }];\n}\n\n$.onStart(()
        => {\n  // Diagnostic: surfaces what was actually baked into the uploaded
        world.\n  // If isTestMode is true on a non-test deployment, the upload pipeline\n 
        // didn't flip it and platform/eligibility checks are silently skipped.\n 
        $.log(\"LUIDA boot: isTestMode=\" + isTestMode\n        + \" expID=\" + (typeof
        expID !== \"undefined\" ? expID : null)\n        + \" pNum=\" + (typeof pNum
        !== \"undefined\" ? pNum : null));\n\n  $.state.betweenSubjectsConfig = []; 
        // populated by ConditionManager message (sent once per space)\n  initSession();\n\n 
        // Place world gate at remote position and keep it enabled\n  $.subNode(\"WorldGateToLuidaBar\").setPosition(REJECTION_GATE_POS);\n 
        $.subNode(\"WorldGateToLuidaBar\").setEnabled(false);\n})\n\n// Per-participant
        session state. Runs at space start and again on \"luida_reset\" (a world
        that lets the next\n// participant start in the same space after End). betweenSubjectsConfig
        is kept.\nfunction initSession() {\n  $.state.isBetweenSubjectsConditionsSet
        = false;\n  $.groupState.sessionID = Date.now() + \"_\" +  (Math.random()
        + 1).toString(36).substring(2, 8);\n  $.groupState.participants = []; //
        array of PlayerHandle who are currently in the experiment\n  $.groupState.qCompletedCount
        = 0;\n  $.state.participantsEnvInfo = [];\n  $.state.idfc2userId = {};\n 
        $.state.timer = 0;\n  $.state.pendingEligibilityChecks = {};\n  $.state.rejectionQueue
        = [];\n  $.state.isProcessingRejection = false;\n  $.state.rejectionTimer
        = 0;\n  $.state.isSessionApproved = false;\n  $.state.existingConditions
        = null;  // existing conditions from server for balancing\n  $.state.betweenSubjectsConditions
        = null;\n  $.state.eligibleCount = 0;  // only confirmed-eligible players
        count toward pNum\n  $.state.participantIdfcs = [];  // idfc of each entry
        of participants (a PlayerHandle has no idfc once the player left)\n  // Last:
        enrollment starts again once this is false, so a failure above leaves enrollment
        blocked.\n  $.groupState.isParticipantsEnough = false;\n}\n\n$.onUpdate((deltaTime)
        => {\n    nr_tick(deltaTime);   // new-participant prompt and session reset
        (see the end of this file)\n\n    if (!$.groupState.isParticipantsEnough)
        {\n        $.state.timer += deltaTime;\n        if ($.state.timer >= 1){\n           
        $.state.timer = 0;\n            let pIdfcs = $.groupState.participants.map(p
        => p.idfc);\n            const newPlayers = $.getPlayersNear($.getPosition(),
        Infinity)\n                .filter(p => !pIdfcs.includes(p.idfc));\n           
        if (newPlayers.length > 0) {\n                for (const newPlayer of newPlayers)
        {\n                    $.groupState.participants = [ ...$.groupState.participants,
        newPlayer ];\n                    $.state.participantIdfcs = [ ...($.state.participantIdfcs
        || []), newPlayer.idfc ];\n                    $.setPlayerScript(newPlayer);\n                   
        newPlayer.send(\"initializeParticipant\", true);\n                }\n           
        }\n            // pNum check moved to onExternalCallEnd \u2014 only eligible
        players count\n        }\n    } else if ($.state.isBetweenSubjectsConditionsSet)
        { // participants are enough & conditions are set\n        $.state.isBetweenSubjectsConditionsSet
        = false;\n        if (!isTestMode) {\n            let request = {\n               
        type: \"uploadCustomData\",\n                data: {\n                   
        pInfo: $.state.participantsEnvInfo.map(info => ({ ts: Date.now(), sID: $.groupState.sessionID
        || \"\", ...info })),\n                    idfc2userId: $.state.idfc2userId\n               
        },\n                token: token || \"\",\n                eID: expID ||
        \"\",\n                sID: $.groupState.sessionID || \"\"\n            };\n           
        $.callExternal(new ExternalEndpointId(callExternalEndpointID), JSON.stringify(request),
        \"customDataUploaded\");\n        }\n    }\n\n    // Process rejection queue:
        teleport rejected players to remote world gate one at a time\n    if ($.state.rejectionQueue.length
        > 0 && !$.state.isProcessingRejection) {\n        const rejection = $.state.rejectionQueue[0];\n       
        const allPlayers = $.getPlayersNear($.getPosition(), Infinity);\n       
        const player = allPlayers.find(p => p.idfc === rejection.idfc);\n\n       
        if (!player) {\n            // Player already left, skip\n            $.state.rejectionQueue
        = $.state.rejectionQueue.slice(1);\n        } else {\n            $.state.isProcessingRejection
        = true;\n            $.state.rejectionTimer = 0;\n            // Teleport
        player to the gate (convert item-local to global coords)\n            $.subNode(\"WorldGateToLuidaBar\").setEnabled(true);\n           
        const itemPos = $.getPosition();\n            player.setPosition(new Vector3(\n               
        REJECTION_GATE_POS.x + itemPos.x,\n                REJECTION_GATE_POS.y +
        itemPos.y + 0.5,\n                REJECTION_GATE_POS.z + itemPos.z\n           
        ));\n            $.log(\"Rejection: teleported player \" + rejection.idfc
        + \" to remote world gate\");\n        }\n    }\n\n    if ($.state.isProcessingRejection)
        {\n        $.state.rejectionTimer += deltaTime;\n        if ($.state.rejectionTimer
        >= 1.5) {\n            const processed = $.state.rejectionQueue[0];\n           
        $.state.rejectionQueue = $.state.rejectionQueue.slice(1);\n            $.state.isProcessingRejection
        = false;\n            $.state.rejectionTimer = 0;\n            $.subNode(\"WorldGateToLuidaBar\").setEnabled(false);\n           
        $.log(\"Rejection: finished processing player \" + (processed ? processed.idfc
        : \"unknown\"));\n        }\n    }\n})\n\n$.onReceive((messageType, arg,
        sender) => {\n    switch (messageType) {\n        case \"betweenSubjectsCondition\":\n           
        $.state.betweenSubjectsConditions = arg;\n            $.state.isBetweenSubjectsConditionsSet
        = true;\n            if (!isTestMode) {\n                // Save conditions
        to backend\n                let saveConditionsRequest = {\n                   
        type: \"saveSessionConditions\",\n                    token: token || \"\",\n                   
        eID: expID || \"\",\n                    sID: $.groupState.sessionID || \"\",\n                   
        betweenSubjectsConditions: arg\n                };\n                $.callExternal(new
        ExternalEndpointId(callExternalEndpointID), JSON.stringify(saveConditionsRequest),
        \"sessionConditionsSaved\");\n            }\n            break;\n       
        case \"betweenSubjectsConfig\":\n            $.state.betweenSubjectsConfig
        = arg;\n            $.log(\"Received betweenSubjectsConfig: \" + JSON.stringify(arg));\n           
        break;\n        case \"envInfoResponse\":\n            // Store envInfo\n           
        $.state.participantsEnvInfo = [\n              ...$.state.participantsEnvInfo,\n             
        { idfc: sender.idfc, envInfo: arg }\n            ];\n            let idfc2userId
        = { ...$.state.idfc2userId };\n            idfc2userId[sender.idfc] = sender.userId;\n           
        $.state.idfc2userId = idfc2userId;\n\n            if (isTestMode) {\n               
        // Local editor test mode: skip both backend eligibility and\n               
        // platform filtering so any device can drive the experiment.\n               
        $.state.eligibleCount++;\n                if (!$.groupState.isParticipantsEnough
        && $.state.eligibleCount >= pNum) {\n                    HandleParticipantsEnough();\n               
        }\n            } else {\n                // Check eligibility via backend
        API\n                let pendingChecks = { ...$.state.pendingEligibilityChecks
        };\n                pendingChecks[sender.idfc] = true;\n                $.state.pendingEligibilityChecks
        = pendingChecks;\n\n                // Build eligibility request\n               
        let eligibilityRequest = {\n                    type: \"checkJoinEligibility\",\n                   
        token: token || \"\",\n                    eID: expID || \"\",\n                   
        sID: $.groupState.sessionID || \"\",\n                    envInfo: [arg]\n               
        };\n\n                // Until session is approved, also include betweenSubjectsConfig
        for session check\n                if (!$.state.isSessionApproved && $.state.betweenSubjectsConfig.length
        > 0) {\n                    eligibilityRequest.betweenSubjectsConfig = $.state.betweenSubjectsConfig;\n               
        }\n\n                $.callExternal(\n                    new ExternalEndpointId(callExternalEndpointID),\n                   
        JSON.stringify(eligibilityRequest),\n                    \"joinEligibilityChecked_\"
        + sender.idfc\n                );\n            }\n            break;\n       
        case \"luida_reset\": {\n            // Sent by an item that resets the session
        from outside (the prompt below resets this item directly).\n            //
        Idempotent per token; the token is saved only after the reset succeeded,
        so a re-send retries a failed one.\n            // Do not send luida_participants_info
        here: the new sessionID has no backend session yet.\n            const resetToken
        = arg && arg.token;\n            if ($.state.luida_lastResetToken !== resetToken)
        {\n                initSession();\n                $.setStateCompat(\"this\",
        \"exp_showWaitingMessage\", true);\n                $.state.luida_lastResetToken
        = resetToken;\n                $.log(\"LUIDA session reset: new sID=\" +
        $.groupState.sessionID);\n            }\n            sender.send(\"luida_reset_ack\",
        { token: resetToken, sessionID: $.groupState.sessionID });\n            break;\n       
        }\n        case \"luida_reset_ack\":\n            // ConditionManager finished
        the reset this item asked for (new-participant prompt).\n            if (arg
        && arg.token && arg.token === $.state.nr_token) $.state.nr_cmAck = arg.token;\n           
        break;\n        case \"luida_prompt_no\":\n            // \"\u7D9A\u304D\u304B\u3089\"
        on the new-participant prompt (NewParticipantPromptNo item): the player says
        they are the\n            // participant who left; put them back into their
        slot instead of resetting.\n            if (($.state.nr_phase || \"idle\")
        === \"asking\" && $.state.nr_shown && arg && arg.player) nr_resume(arg.player);\n           
        break;\n        default:\n            break;\n    }\n}, { item: true, player:
        true });\n\nfunction HandleParticipantsEnough() {\n  $.log(\"Participants
        are enough to start the experiment.\");\n  $.groupState.isParticipantsEnough
        = true;\n  $.sendSignalCompat(\"this\", \"exp_playersAreEnough\");\n  $.sendSignalCompat(\"this\",
        \"exp_StartStateTransition\");\n\n  const conditionManager = $.worldItemReference(\"ConditionManager\");\n 
        if (conditionManager) {\n    // If server returned existing conditions, send
        them for local balancing\n    if ($.state.isSessionApproved && $.state.existingConditions)
        {\n      conditionManager.send(\"luida_existing_conditions\", $.state.existingConditions);\n   
        } else if (typeof expID === \"undefined\" || !expID) {\n      // No expID
        \u2192 no server balancing possible. [] makes ConditionManager pick a random
        combination.\n      conditionManager.send(\"luida_existing_conditions\",
        []);\n    }\n    conditionManager.send(\"luida_participants_info\", {\n     
        participants: $.groupState.participants,\n      sessionID: $.groupState.sessionID\n   
        });\n  }\n}\n\n$.onExternalCallEnd((res, meta, err) => {\n  if (meta.startsWith(\"joinEligibilityChecked_\"))
        {\n    const idfc = meta.replace(\"joinEligibilityChecked_\", \"\");\n\n   
        // Clear pending check regardless of outcome\n    let pendingChecks = { ...$.state.pendingEligibilityChecks
        };\n    delete pendingChecks[idfc];\n    $.state.pendingEligibilityChecks
        = pendingChecks;\n\n    if (res == null) {\n      // Graceful degradation:
        treat as eligible so experiment can proceed with local conditions\n     
        $.log(\"Eligibility check ERROR for \" + idfc + \": \" + err);\n      $.state.eligibleCount++;\n     
        if (!$.groupState.isParticipantsEnough && $.state.eligibleCount >= pNum)
        {\n        HandleParticipantsEnough();\n      }\n      return;\n    }\n\n   
        const parsedRes = JSON.parse(res);\n\n    if (!parsedRes.eligible) {\n     
        enqueueRejection(idfc, parsedRes.reason);\n      return;\n    }\n\n    //
        Player is eligible\n    $.state.eligibleCount++;\n\n    // Check if response
        includes session status info (existing conditions for local balancing)\n   
        if (parsedRes.existingConditions !== undefined) {\n      $.state.isSessionApproved
        = true;\n      $.state.existingConditions = parsedRes.existingConditions;\n     
        $.log(\"Session approved. Existing conditions: \" + JSON.stringify(parsedRes.existingConditions));\n   
        }\n\n    // Check pNum \u2014 only after eligibility is confirmed\n    if
        (!$.groupState.isParticipantsEnough && $.state.eligibleCount >= pNum) {\n     
        HandleParticipantsEnough();\n    }\n    return;\n  }\n\n  if (meta === \"sessionConditionsSaved\")
        {\n    if (res == null) {\n      $.log(\"saveSessionConditions ERROR: \"
        + err);\n    } else {\n      $.log(\"Session conditions saved: \" + JSON.stringify(res));\n   
        }\n    return;\n  }\n\n  if (meta === \"customDataUploaded\") {\n    if (res
        == null) {\n      $.log(\"callExternal ERROR: \" + err);\n      return;\n   
        }\n    $.log(\"Response after customDataUploaded called: \" + JSON.stringify(res));\n   
        return;\n  }\n\n  // Fallback for unknown meta\n  if (res == null) {\n   
        $.log(\"callExternal ERROR (\" + meta + \"): \" + err);\n  }\n});\n\n// ----
        New-participant prompt and session reset ----\n// Once a session is in use
        (isParticipantsEnough is true: running or finished), this item looks once
        a second\n// for players who are not enrolled while none of the enrolled
        participants is still here (they finished and\n// left, or left in the middle;
        scripts only run while someone is in the space, so this happens when the
        next\n// player joins). Such a player sees a small red panel close in front
        of them: \"you seem to have entered a session\n// that was interrupted or
        has ended; OK starts the experiment from the beginning\".\n//   \"OK\"     
        (sub-node NewParticipantPromptOk, the only collider of this item, $.onInteract):
        reset the globals\n//             (signal exp_sessionReset -> GlobalLogics
        on this prefab) and ConditionManager, confirm both, then this\n//            
        item (initSession), after which enrollment resumes exactly as at space start.\n//  
        \"\u7D9A\u304D\u304B\u3089\" (item NewParticipantPromptNo, shown under \"OK\"
        only when the player uses the account of an enrolled\n//             participant
        who left): the player is put back into their participant slot and the session
        goes on.\n// Nothing is reset before an answer. Each reset step is confirmed
        and never advances on a timeout; after\n// NR_ALERT_SEC without confirmation
        the panel shows an error (and keeps retrying). Worlds whose\n// ParticipantManager
        prefab has no NewParticipantPrompt sub-node never show the prompt and never
        reset.\n// Panel layout in LUIDA-ExpManagers (overrides on the ParticipantManager
        prefab): 0.7 x 0.4 m centred at y = +0.03,\n// text at y = +0.075 (size 0.015,
        about 24 Japanese characters per line), \"OK\" at y = -0.1. \"\u7D9A\u304D\u304B\u3089\"
        (0.3 x 0.05 m)\n// sits at NR_NO_OFFSET under \"OK\" and carries a 0.7 x
        0.05 m strip of the panel colour that extends the panel\n// downward while
        it is shown.\nconst NR_POLL_SEC = 1;\nconst NR_PROMPT_DELAY_SEC = 3;    
        // first seen -> panel shown (lets End's upload be issued under the old sessionID;
        lets the avatar settle)\nconst NR_RESEND_SEC = 2;           // re-send unconfirmed
        reset requests (the handlers are idempotent per token)\nconst NR_ALERT_SEC
        = 15;\nconst NR_DIST = 0.5;               // panel distance in front of the
        player [m] (close, so the panel and its text are small)\nconst NR_HEIGHT
        = 1.4;             // panel height when the head bone cannot be read [m]\nconst
        NR_REPLACE_DIST = 1;         // the player walked this far from where they
        were asked: place the panel again\nconst NR_NODE = \"NewParticipantPrompt\";\nconst
        NR_TEXT = \"NewParticipantPromptText\";\nconst NR_OK = \"NewParticipantPromptOk\";\nconst
        NR_NO_ITEM = \"NewParticipantPromptNo\";                 // world item reference
        (LUIDA-ExpManagers prefab)\nconst NR_NO_OFFSET = new Vector3(0, -0.165, -0.01);         
        // \"\u7D9A\u304D\u304B\u3089\" relative to the panel, under \"OK\"\nconst
        NR_TEXT_ASK = \"\u4E2D\u65AD\u307E\u305F\u306F\u7D42\u4E86\u3057\u305F\u30BB\u30C3\u30B7\u30E7\u30F3\u306B\u5165\u3063\u305F\u3088\u3046\u3067\u3059\u3002\\n\u300COK\u300D\u3092\u62BC\u3059\u3068\u3001\u5B9F\u9A13\u3092\u6700\u521D\u304B\u3089\u59CB\u3081\u307E\u3059\u3002\\n\"
        +\n                    \"It seems you have entered a session that\\nwas interrupted
        or has ended.\\nPress OK to restart the experiment\\nfrom the beginning.\";\nconst
        NR_TEXT_ASK_RESUME = \"\u4E2D\u65AD\u3057\u305F\u30BB\u30C3\u30B7\u30E7\u30F3\u306B\u623B\u3063\u3066\u304D\u305F\u3088\u3046\u3067\u3059\u3002\\n\u300COK\u300D\u3067\u6700\u521D\u304B\u3089\u3001\u300C\u7D9A\u304D\u304B\u3089\u300D\u3067\u518D\u958B\u3057\u307E\u3059\u3002\\n\"
        +\n                           \"You seem to have returned to an\\ninterrupted
        session.\\nPress OK to start over,\\nor Resume to continue.\";\nconst NR_TEXT_BUSY
        = \"\u521D\u671F\u5316\u3057\u3066\u3044\u307E\u3059\u3002\u3057\u3070\u3089\u304F\u304A\u5F85\u3061\u304F\u3060\u3055\u3044\u2026\\nResetting
        the experiment, please wait\u2026\";\nconst NR_TEXT_ERROR = \"\u30A8\u30E9\u30FC\uFF1A\u5B9F\u9A13\u306E\u521D\u671F\u5316\u306B\u5931\u6557\u3057\u307E\u3057\u305F\u3002\\n\u5B9F\u9A13\u8005\u306B\u3054\u9023\u7D61\u304F\u3060\u3055\u3044\u3002\\nError:
        the reset failed.\\nPlease contact the experimenter.\";\n\nfunction nr_node(name)
        { try { return $.subNode(name); } catch (e) { return null; } }\nfunction
        nr_noItem() { try { return $.worldItemReference(NR_NO_ITEM); } catch (e)
        { return null; } }\nfunction nr_phase(p) { $.state.nr_phase = p; $.state.nr_phaseSec
        = 0; $.state.nr_lastSend = -1e9; }\n\nfunction nr_show(text, withOk, withNo)
        {\n  const panel = nr_node(NR_NODE);\n  if (!panel) return;\n  const t =
        nr_node(NR_TEXT); if (t) t.setText(text);\n  const ok = nr_node(NR_OK); if
        (ok) ok.setEnabled(withOk);\n  panel.setEnabled(true);\n  const no = nr_noItem();
        if (no) no.send(withNo ? \"luida_prompt_show\" : \"luida_prompt_hide\", {});\n 
        $.state.nr_shown = true;\n}\n\nfunction nr_hide() {\n  const panel = nr_node(NR_NODE);
        if (panel) panel.setEnabled(false);\n  const no = nr_noItem(); if (no) no.send(\"luida_prompt_hide\",
        {});\n  $.state.nr_shown = false;\n  $.state.nr_placed = false;\n  $.state.nr_for
        = null;\n}\n\n// Puts the (hidden) panel NR_DIST in front of the player at
        head height, facing them, and parks the \"\u7D9A\u304D\u304B\u3089\"\n//
        item next to it. Sub-node positions are item-local; the \"\u7D9A\u304D\u304B\u3089\"
        item is a separate movable item (world pose).\nfunction nr_place(player)
        {\n  const panel = nr_node(NR_NODE);\n  if (!panel) return false;\n  const
        pPos = player.getPosition(), pRot = player.getRotation();\n  if (!pPos ||
        !pRot) return false;\n  let h = NR_HEIGHT;\n  if (!isTestMode) {   // the
        editor emulator may throw on bone reads; on Cluster a missing bone is null\n   
        try { const head = player.getHumanoidBonePosition(HumanoidBone.Head); if
        (head) h = Math.min(1.8, Math.max(0.9, head.y - pPos.y)); } catch (e) {}\n 
        }\n  let fwd = new Vector3(0, 0, 1).applyQuaternion(pRot); fwd.y = 0;\n 
        if (fwd.length() < 0.001) fwd = new Vector3(0, 0, 1); else fwd.normalize();\n 
        const rot = new Quaternion().setFromEulerAngles(new Vector3(0, Math.atan2(fwd.x,
        fwd.z) * 180 / Math.PI, 0));\n  const world = pPos.clone().add(fwd.clone().multiplyScalar(NR_DIST)).add(new
        Vector3(0, h, 0));\n  const inv = $.getRotation().clone().invert();\n  panel.setPosition(world.clone().sub($.getPosition()).applyQuaternion(inv));\n 
        panel.setRotation(inv.clone().multiply(rot));\n  const no = nr_noItem();\n 
        if (no) no.send(\"luida_prompt_place\", { pos: world.clone().add(NR_NO_OFFSET.clone().applyQuaternion(rot)),
        rot: rot });\n  $.state.nr_anchor = pPos;\n  return true;\n}\n\nfunction
        nr_far(player) {\n  const a = $.state.nr_anchor, p = player.getPosition();\n 
        if (!a || !p) return false;\n  return p.clone().sub(a).length() > NR_REPLACE_DIST;\n}\n\n//
        Slot of an enrolled participant who left and used the same account as this
        player; -1 if none.\nfunction nr_resumeIndex(player) {\n  if (!player ||
        !player.idfc) return -1;\n  const idfcs = $.state.participantIdfcs || [];\n 
        const ps = $.groupState.participants || [];\n  for (let i = 0; i < ps.length;
        i++) {\n    if (idfcs[i] === player.idfc && ps[i] && !ps[i].exists() && ps[i].id
        !== player.id) return i;\n  }\n  return -1;\n}\n\nfunction nr_globalsReset()
        {\n  return $.getStateCompat(\"global\", \"state_currentID\", \"integer\")
        === 0\n      && $.getStateCompat(\"global\", \"exp_trialID\", \"integer\")
        === 0\n      && $.getStateCompat(\"global\", \"exp_readyToLeaveTrials\",
        \"boolean\") === false\n      && $.getStateCompat(\"global\", \"exp_arePlayersEnough\",
        \"boolean\") === false;\n}\n\nfunction nr_sendResets(globals, cm) {\n  if
        (globals) $.sendSignalCompat(\"this\", \"exp_sessionReset\");    // GlobalLogics
        on this prefab: state_exited, state_currentID = 0, ...\n  if (cm) {\n   
        const h = $.worldItemReference(\"ConditionManager\");\n    if (h) h.send(\"luida_reset\",
        { token: $.state.nr_token });\n    else $.log(\"[PM] ConditionManager reference
        missing; the session cannot be reset\");\n  }\n  $.state.nr_lastSend = $.state.nr_phaseSec;\n}\n\nfunction
        nr_startReset(player) {\n  $.state.nr_token = ($.groupState.sessionID ||
        \"none\") + \":\" + Date.now();\n  $.state.nr_cmAck = null;\n  $.log(\"[PM]
        new participant confirmed (\" + (player && player.idfc) + \"); resetting
        the session, token=\" + $.state.nr_token);\n  nr_phase(\"settle\");\n  nr_sendResets(true,
        true);\n  nr_show(NR_TEXT_BUSY, false, false);\n}\n\nfunction nr_finishReset()
        {\n  try {\n    initSession();\n    $.setStateCompat(\"this\", \"exp_showWaitingMessage\",
        true);\n  } catch (e) {\n    $.log(\"[PM] initSession failed: \" + e);  
        // retried at the next poll\n    nr_show(NR_TEXT_ERROR, false, false);\n   
        return;\n  }\n  $.log(\"LUIDA session reset: new sID=\" + $.groupState.sessionID);\n 
        nr_hide();\n  nr_phase(\"idle\");\n}\n\nfunction nr_resume(player) {\n  const
        i = nr_resumeIndex(player);\n  if (i < 0) {\n    $.log(\"[PM] '\u7D9A\u304D\u304B\u3089'
        pressed by a player who cannot resume; prompt closed\");\n    nr_hide();
        nr_phase(\"idle\");\n    return;\n  }\n  const ps = $.groupState.participants.slice();\n 
        ps[i] = player;\n  $.groupState.participants = ps;\n  $.setPlayerScript(player);\n 
        const cm = $.worldItemReference(\"ConditionManager\");\n  if (cm) cm.send(\"luida_rebind_participant\",
        { index: i, player: player });\n  $.log(\"[PM] participant \" + (i + 1) +
        \" rejoined (\" + player.idfc + \"); the session continues\");\n  nr_hide();
        nr_phase(\"idle\");\n}\n\nfunction nr_tick(dt) {\n  $.state.nr_pollIn = ($.state.nr_pollIn
        || 0) - dt;\n  if ($.state.nr_pollIn > 0) return;\n  $.state.nr_pollIn =
        NR_POLL_SEC;\n  const phase = $.state.nr_phase || \"idle\";\n  $.state.nr_phaseSec
        = ($.state.nr_phaseSec || 0) + NR_POLL_SEC;\n\n  if (phase === \"settle\")
        {\n    const acked = $.state.nr_cmAck === $.state.nr_token;\n    const globals
        = nr_globalsReset();\n    if (acked && globals) { nr_finishReset(); return;
        }\n    if ($.state.nr_phaseSec - $.state.nr_lastSend >= NR_RESEND_SEC) {\n     
        $.log(\"[PM] reset not confirmed yet (globals=\" + globals + \", conditionManager=\"
        + acked + \"); re-sending\");\n      nr_sendResets(!globals, !acked);\n   
        }\n    if ($.state.nr_phaseSec >= NR_ALERT_SEC) nr_show(NR_TEXT_ERROR, false,
        false);\n    return;\n  }\n\n  // idle / asking\n  if (!$.groupState.isParticipantsEnough)
        { if (phase !== \"idle\") { nr_hide(); nr_phase(\"idle\"); } return; }\n 
        const present = $.getPlayersNear($.getPosition(), Infinity);\n  const ps
        = $.groupState.participants || [];\n  const ids = ps.map(p => p.id);\n  //
        enrolled participants still here: exists() stays true through a short network
        hiccup; the id is unique per join\n  const enrolledHere = ps.some(p => p.exists())
        || present.some(q => ids.includes(q.id));\n  const strangers = present.filter(q
        => !ids.includes(q.id));\n  if (enrolledHere || strangers.length === 0) {
        if (phase !== \"idle\") { nr_hide(); nr_phase(\"idle\"); } return; }\n  const
        s = strangers.find(q => q.id === $.state.nr_for) || strangers[0];\n  if (phase
        === \"idle\") {\n    nr_phase(\"asking\");\n    $.state.nr_for = s.id; $.state.nr_placed
        = false; $.state.nr_shown = false;\n    $.log(\"[PM] a player who is not
        enrolled is here and no enrolled participant is; asking in \" + NR_PROMPT_DELAY_SEC
        + \" s\");\n    return;\n  }\n  if ($.state.nr_phaseSec < NR_PROMPT_DELAY_SEC)
        return;\n  if (!$.state.nr_placed || $.state.nr_for !== s.id || nr_far(s))
        {\n    // move while hidden; show at the next poll, after the move has been
        synchronized\n    if ($.state.nr_shown) { const panel = nr_node(NR_NODE);
        if (panel) panel.setEnabled(false); const no = nr_noItem(); if (no) no.send(\"luida_prompt_hide\",
        {}); $.state.nr_shown = false; }\n    $.state.nr_for = s.id;\n    $.state.nr_placed
        = nr_place(s);\n    return;\n  }\n  if (!$.state.nr_shown) {\n    const canResume
        = nr_resumeIndex(s) >= 0;\n    nr_show(canResume ? NR_TEXT_ASK_RESUME : NR_TEXT_ASK,
        true, canResume);\n  }\n}\n\n$.onInteract((player) => {   // \"OK\" (the
        only collider of this item)\n  if (($.state.nr_phase || \"idle\") !== \"asking\"
        || !$.state.nr_shown) return;\n  nr_startReset(player);\n});\n"
