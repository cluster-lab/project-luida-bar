--- !u!1001 &7533049804749356258
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 97919917519858158, guid: c429a845517c96a419988cd638c846f1,
        type: 3}
      propertyPath: id.value
      value: 6820867083180501663
      objectReference: {fileID: 0}
    - target: {fileID: 908684358854966727, guid: c429a845517c96a419988cd638c846f1,
        type: 3}
      propertyPath: m_Name
      value: ExpTemplateRequiredObjects
      objectReference: {fileID: 0}
    - target: {fileID: 2948447358681182120, guid: c429a845517c96a419988cd638c846f1,
        type: 3}
      propertyPath: clusterScripts.Array.size
      value: 3
