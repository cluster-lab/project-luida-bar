--- !u!1001 &4731245737585559075
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 4638770987403183712, guid: 582d9461e4f86459080aac4eee555440,
        type: 3}
      propertyPath: clusterScripts.Array.size
      value: 1
