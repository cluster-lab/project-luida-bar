--- !u!1001 &3837805225769982424
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    m_TransformParent: {fileID: 8059115898024360096}
    m_Modifications:
    - target: {fileID: 1500171154761029595, guid: 33f2af324e4cc4f2594dfbed4b8752fa,
        type: 3}
      propertyPath: sourceCode
      value: "const TOKEN = \"\";\nconst ENDPOINT_ID = \"\";\nconst IS_TEST = false;\n\r\n$.onInteract((player)
        => {\r\n    if (!$.groupState.quests) return;\r\n    const triggerQuestID
        = $.getStateCompat(\"this\", \"triggerQuest\", \"integer\");\r\n    const
        quest = $.groupState.quests[triggerQuestID];\r\n    if (!quest) return;\r\n\r\n   
        $.setStateCompat(\"owner\", \"DisplayQuestInfo\", true);\r\n    const worldItemTemplateId
        = new WorldItemTemplateId(\"questInfoText\");\r\n    const questInfoText
        = $.createItem(worldItemTemplateId, new Vector3(0, 1.65, 1.7), new Quaternion());\r\n   
        const eID = quest.eID;\r\n    questInfoText.send(\"onCreate\", { player,
        eID, token: TOKEN, endpointId: ENDPOINT_ID, isTest: IS_TEST });\r\n\r\n   
        let questIdByPlayerID = { ...$.groupState.questIdByPlayerID };\r\n    questIdByPlayerID[player.id]
        = ($.groupState.currentPage - 1) * 30 + triggerQuestID + 1;\r\n    $.groupState.questIdByPlayerID
        = questIdByPlayerID;\r\n})\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 3643936778385026698, guid: 33f2af324e4cc4f2594dfbed4b8752fa,
        type: 3}
      propertyPath: triggers.Array.data[1].value.integerValue
      value: 17
      objectReference: {fileID: 0}
    - target: {fileID: 3643936778385026699, guid: 33f2af324e4cc4f2594dfbed4b8752fa,
        type: 3}
      propertyPath: id.value
      value: 528709082565309990
